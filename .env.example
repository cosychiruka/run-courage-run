# Backend LLM
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-your-openrouter-key
DEFAULT_MODEL=qwen/qwen3-coder:free
FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_REFERER=https://github.com/cosychiruka/run-courage-run
OPENROUTER_TITLE=Run Courage Run
LLM_DAILY_TOKEN_BUDGET=500000

# Legacy Groq fallback. Leave unset unless LLM_PROVIDER=groq.
# GROQ_API_KEY=gsk-your-groq-key
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL_FAST=llama-3.1-8b-instant

# Backend services
REDIS_URL=redis://localhost:6379
DB_PATH=server/data/courage.db
FRONTEND_ORIGIN=http://localhost:5173
AUTONOMOUS_INTERVAL_MINUTES=60
X_DAILY_SEARCH_SPEND_CAP=5.0

# News APIs
GNEWS_API_KEY=your_gnews_api_key
GUARDIAN_API_KEY=your_guardian_api_key
NEWS_API_KEY=your_newsapi_key
FIRECRAWL_API_KEY=your_firecrawl_key
COINDESK_API_KEY=your_coindesk_key
COINGECKO_API_KEY=your_coingecko_key

# X / Twitter API. These must be server-side secrets in production.
X_BEARER_TOKEN=your_x_bearer_token
X_CONSUMER_KEY=your_x_consumer_key
X_CONSUMER_SECRET=your_x_consumer_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret

# Art / token config
FAL_API_KEY=your_fal_key
RCR_TOKEN_ADDRESS=SOL_FALLBACK
COURAGE_BASE_IMAGE_URL=https://example.com/courage-base.png

# Frontend Environment Variables (Vite requires VITE_ prefix for client-side access)
VITE_BACKEND_WS=ws://localhost:8000/ws/voice
VITE_BACKEND_URL=http://localhost:8000
VITE_NODE_ENV=development
