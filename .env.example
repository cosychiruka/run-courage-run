# Frontend Environment Variables (Vite requires VITE_ prefix for client-side access)

# Backend WebSocket URL (voice chat)
VITE_BACKEND_WS=ws://localhost:8000/ws/voice
# Production backend URL (update after deployment)
VITE_BACKEND_URL=http://localhost:8000

# News API Keys (these are used by the frontend for direct API calls)
