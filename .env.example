# Frontend Environment Variables (Vite requires VITE_ prefix for client-side access)

# Backend WebSocket URL (voice chat)
VITE_BACKEND_WS=ws://localhost:8000/ws/voice
# Production backend URL (update after deployment)
VITE_BACKEND_URL=http://localhost:8000

# News API Keys (these are used by the frontend for direct API calls)
VITE_GNEWS_API_KEY=your_gnews_api_key_here
VITE_GUARDIAN_API_KEY=your_guardian_api_key_here  
VITE_NEWS_API_KEY=your_news_api_key_here

# Twitter/X API Keys (for frontend Twitter integration)
VITE_X_BEARER_TOKEN=your_twitter_bearer_token_here
VITE_X_ACCESS_TOKEN=your_twitter_access_token_here
VITE_X_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here
VITE_X_CONSUMER_KEY=your_twitter_consumer_key_here
VITE_X_CONSUMER_SECRET=your_twitter_consumer_secret_here

# Optional: Additional configuration
VITE_NODE_ENV=development
