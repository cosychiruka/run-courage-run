# Backend LLM
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-your-openrouter-key
DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Cheap paid fallback; add OpenRouter credit before relying on it.
FALLBACK_MODEL=qwen/qwen3-30b-a3b-instruct-2507
OPENROUTER_REFERER=https://hoodcourage.xyz
OPENROUTER_TITLE=Run Courage Run
LLM_DAILY_TOKEN_BUDGET=500000

# Backend services
REDIS_URL=redis://localhost:6379
DB_PATH=server/data/courage.db
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=https://hoodcourage.xyz
AUTONOMOUS_INTERVAL_MINUTES=60
X_DAILY_SEARCH_SPEND_CAP=5.0

# 1 GB deployment defaults: load only one local voice model at a time and use
# lightweight lexical retrieval instead of keeping an embedding model resident.
VOICE_MEMORY_MODE=low
WHISPER_MODEL=tiny.en
WHISPER_BEAM_SIZE=1
KOKORO_MODEL_PATH=kokoro-v1.0.int8.onnx
KOKORO_VOICES_PATH=voices-v1.0.bin
KOKORO_VOICE=af_bella
RAG_MODE=lexical

# Crypto editorial feed. CoinDesk RSS is the keyless fallback.
COINDESK_API_KEY=your_coindesk_key
# Optional full-article extraction for Chronicle summaries.
FIRECRAWL_API_KEY=your_firecrawl_key

# X / Twitter API. These must be server-side secrets in production.
# Both switches are fail-closed. Enable background work and X independently in production.
BACKGROUND_AUTOMATION_ENABLED=false
X_AUTOMATION_ENABLED=false
X_EXPECTED_USERNAME=cowardlyhood
X_BEARER_TOKEN=your_x_bearer_token
X_CONSUMER_KEY=your_x_consumer_key
X_CONSUMER_SECRET=your_x_consumer_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret

# Art
FAL_API_KEY=your_fal_key
COURAGE_BASE_IMAGE_URL=https://example.com/courage-base.png

# Legacy project-token compatibility. Leave empty for the current
# Robinhood Chain discovery-first experience.
RCR_TOKEN_ADDRESS=

# Frontend Environment Variables (Vite requires VITE_ prefix for client-side access)
VITE_BACKEND_WS=ws://localhost:8000/ws/voice
VITE_BACKEND_URL=http://localhost:8000
VITE_NODE_ENV=development
