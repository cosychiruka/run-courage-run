# The backend and Docker Compose read ../.env. Copy the repository-root
# .env.example to .env; this file mirrors the backend-only subset for reference.

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-your-openrouter-key
DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
FALLBACK_MODEL=qwen/qwen3-30b-a3b-instruct-2507
OPENROUTER_REFERER=https://hoodcourage.xyz
OPENROUTER_TITLE=Run Courage Run
LLM_DAILY_TOKEN_BUDGET=500000

# Optional. Leave blank for the single-process memory/SQLite cache. Set only to
# a Redis service whose internal hostname resolves from this deployment.
REDIS_URL=
# Optional. Blank uses the backend's bundled data directory.
DB_PATH=
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=https://hoodcourage.xyz
AUTONOMOUS_INTERVAL_MINUTES=60
X_DAILY_SEARCH_SPEND_CAP=5.0

VOICE_MEMORY_MODE=low
WHISPER_MODEL=tiny.en
WHISPER_BEAM_SIZE=1
KOKORO_MODEL_PATH=kokoro-v1.0.int8.onnx
KOKORO_VOICES_PATH=voices-v1.0.bin
KOKORO_VOICE=af_bella
RAG_MODE=lexical

COINDESK_API_KEY=
FIRECRAWL_API_KEY=

BACKGROUND_AUTOMATION_ENABLED=false
X_AUTOMATION_ENABLED=false
X_EXPECTED_USERNAME=cowardlyhood
X_BEARER_TOKEN=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

FAL_API_KEY=
COURAGE_BASE_IMAGE_URL=

# Legacy compatibility only; not used by the Robinhood Chain discovery feed.
RCR_TOKEN_ADDRESS=
