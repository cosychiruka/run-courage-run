# ── LLM ───────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Alternatives: qwen3:8b  (newer, slightly more capable, needs ~6GB VRAM)
# Note: qwen2.5-coder:7b is the best small tool-caller — 3B/1.5B have poor restraint

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── SQLite (absolute path inside container) ───────────────────────────────────
DB_PATH=/app/data/courage.db

# ── News APIs ─────────────────────────────────────────────────────────────────
GNEWS_API_KEY=your_gnews_key_here
GUARDIAN_API_KEY=your_guardian_key_here     # 'test' works for low-volume dev

# ── Twitter / X (OAuth 1.0a, Read + Write permissions required) ───────────────
X_CONSUMER_KEY=your_consumer_key
X_CONSUMER_SECRET=your_consumer_secret
X_ACCESS_TOKEN=your_access_token
X_ACCESS_TOKEN_SECRET=your_access_token_secret
X_BEARER_TOKEN=your_bearer_token

# ── Article full-text fetching ────────────────────────────────────────────────
FIRECRAWL_API_KEY=your_firecrawl_key_here   # optional — Jina reader is free fallback
# Jina fallback URL pattern: https://r.jina.ai/{article_url} (no key needed)

# ── CORS origin for the React dev server ─────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Crypto News ──────────────────────────────────────────────────────────────
# CryptoPanic: free API key at https://cryptopanic.com/developers/api
CRYPTOPANIC_API_KEY=
# CoinGecko: free Demo key at https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# ── Autonomous Heartbeat ──────────────────────────────────────────────────────
# Interval in minutes between autonomous ticks (default: 18)
AUTONOMOUS_INTERVAL_MINUTES=18

RCR_TOKEN_ADDRESS=   # ← we will set this later (Solana address of $RCR)
FAL_API_KEY=         # ← get free key at https://fal.ai
COURAGE_BASE_IMAGE_URL=https://yourdomain.com/public/courage-base.png   # ← upload your base Courage PNG to public/ and put real URL here
