# The backend and Docker Compose read ../.env. Copy the repository-root
# .env.example to .env; this file mirrors the backend-only subset for reference.

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-your-openrouter-key
DEFAULT_MODEL=qwen/qwen3-coder:free
FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_REFERER=https://github.com/cosychiruka/run-courage-run
OPENROUTER_TITLE=Run Courage Run
LLM_DAILY_TOKEN_BUDGET=500000

REDIS_URL=redis://localhost:6379
DB_PATH=server/data/courage.db
FRONTEND_ORIGIN=http://localhost:5173
AUTONOMOUS_INTERVAL_MINUTES=60
X_DAILY_SEARCH_SPEND_CAP=5.0

GNEWS_API_KEY=
GUARDIAN_API_KEY=test
NEWS_API_KEY=
FIRECRAWL_API_KEY=
COINDESK_API_KEY=
COINGECKO_API_KEY=

BACKGROUND_AUTOMATION_ENABLED=false
X_AUTOMATION_ENABLED=false
X_EXPECTED_USERNAME=cowardlyhood
X_BEARER_TOKEN=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

FAL_API_KEY=
COURAGE_BASE_IMAGE_URL=

# Legacy compatibility only; not used by the Robinhood Chain discovery feed.
RCR_TOKEN_ADDRESS=
